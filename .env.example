# StudioSpace Client Environment Variables

# Backend Express API Base URL (e.g. http://localhost:5000 in local dev, or https://studiospace-server-meof.onrender.com in production)
NEXT_PUBLIC_API_URL=http://localhost:5000

# BetterAuth secret used to encrypt cookies and sign session tokens (min 32 random characters)
# Generate one via `openssl rand -base64 32` or any secure random string generator
BETTER_AUTH_SECRET=change-me-long-random-string-at-least-32-chars

# The canonical client URL (e.g. http://localhost:3000 in dev, https://studiospace-client.vercel.app in prod)
BETTER_AUTH_URL=http://localhost:3000

# MongoDB connection string for BetterAuth user/account/session management
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/studiospace?retryWrites=true&w=majority

# Optional: MongoDB database name (defaults to studiospace)
DB_NAME=studiospace

# Google OAuth 2.0 Client credentials (obtain from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ImgBB API Key for host studio image uploads (/add-studio)
# Get a free key at https://api.imgbb.com/
NEXT_PUBLIC_IMGBB_KEY=your-imgbb-api-key
